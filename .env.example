# Copy to .env — Day 1 free setup (Gemini primary, no paid key needed)
PORT=3000
UPSTREAM_TIMEOUT_MS=25000
LOG_LEVEL=info

# One active PROVIDER: mock | gemini | ollama | openai
PROVIDER=mock

# Gemini Flash (PRIMARY) — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Ollama local (FALLBACK for load/stampede tests) — after `ollama run llama3.1:8b`
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1:8b

# OpenAI paid (later only, never required Weeks 1-4)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
