# Relay — LLM Gateway environment template.
#   cp .env.example .env
#
# Every variable below is optional: `npm run dev` starts on the mock provider with no .env
# at all. Set only what you actually route to.
# Parsed in exactly one place: src/infrastructure/config.ts.

# ── Core ──────────────────────────────────────────────────────────────────────
PORT=3000
# mock | gemini | ollama | openai | anthropic | openrouter
PROVIDER=mock
UPSTREAM_TIMEOUT_MS=25000

# ── Providers (fill in only the ones you route to) ────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-4
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Mind the naming: the key is OPEN_ROUTER_KEY (underscore), the rest are OPENROUTER_*.
# :free models are $0 but still need a free account key — there is no anonymous access.
# Free ids churn: the default below was verified against the live $0 tier (2026-10-26);
# override with any current :free id from https://openrouter.ai/models?max_price=0.
OPEN_ROUTER_KEY=
OPENROUTER_MODEL=cohere/north-mini-code:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b

# ── Exact cache ───────────────────────────────────────────────────────────────
CACHE_ENABLED=true
CACHE_TTL_S=3600
# Blank uses the in-memory LRU. Set to put the exact cache in Redis.
REDIS_URL=

# ── Semantic cache ────────────────────────────────────────────────────────────
SEMANTIC_ENABLED=true
# mock | gemini | ollama | local
# local = built-in ONNX sentence embeddings: no key, no server. Offline after the
# first model download (~109 MB into ./.cache; the Docker image ships it baked in).
# With local, keep SEMANTIC_THRESHOLD at 0.95 (duplicate/formatting reuse only):
# the real-embedding evaluation (evaluation/real-embeddings-report.md) measured
# 4 wrong-answer reuses at 0.92 and zero at 0.95 on its 233-pair corpus.
EMBEDDING_PROVIDER=mock
# Overrides the embedder model (local default: Xenova/all-mpnet-base-v2, 768-d).
EMBEDDING_MODEL=
# Paraphrase similarity cutoff, between 0 and 1. Default 0.95 is the measured
# zero-false-positive boundary for the local embedder; lower values trade safety
# for paraphrase hit rate (see the evaluation report before changing it).
SEMANTIC_THRESHOLD=0.95
SEMANTIC_TOP_K=3
SEMANTIC_TTL_S=3600
# memory | pgvector (pgvector needs DATABASE_URL and db/migrations applied)
SEMANTIC_STORE=memory

# ── SSRF guard for tenant-supplied provider URLs ───────────────────────────────
# POST /v1/register and /v1/connections accept an optional base_url. By default
# loopback, RFC1918/CGNAT, link-local (incl. 169.254.169.254), IPv6 ULA/link-local,
# unspecified/multicast/reserved destinations and URLs with embedded credentials
# are rejected after DNS resolution. Set to 1 only for a trusted self-hosted
# provider (e.g. Ollama on 127.0.0.1 or a private LAN endpoint).
ALLOW_PRIVATE_PROVIDER_URLS=

# ── Postgres, multi-tenancy, provider credentials ─────────────────────────────
# Setting DATABASE_URL requires CRED_ENC_KEY: stored provider keys are encrypted at rest.
DATABASE_URL=
CRED_ENC_KEY=
# Comma-separated seed gateway keys, each shaped tenant:provider:name:key
GATEWAY_API_KEYS=

# ── Cost reporting ────────────────────────────────────────────────────────────
# Zero disables savings estimates in /metrics.
SAVED_USD_PER_1K_TOKENS=0

# ── Deliberately absent ───────────────────────────────────────────────────────
# The live-test opt-ins (GEMINI_LIVE_TEST, OPENROUTER_LIVE_TEST, REDIS_LIVE_TEST,
# EMBEDDING_LIVE_TEST) are not listed here on purpose: they must be passed on the
# command line, so a .env file can never make the default `npm test` sweep call an
# external provider or download a model. See "Test report" in README.md.
